<!-- Dainvo: commands for features Dainvo doesn't ship (remote files, CMIS,
     scanning, Bluetooth, document versions and classification, extensions,
     databases and mail merge, PDF signing of existing files, Impress Remote,
     Calc document sharing and experimental data sources, LibreOffice
     community help, and the interface/toolbar pickers: Dainvo is
     ribbon-only). Disabled commands are hidden from menus, toolbars and
     context menus and can't be run from shortcuts. Macro commands are handled
     at startup instead (desktop/source/app/dainvofirstrun.cxx), because the
     user can turn macros on. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Commands" oor:package="org.openoffice.Office">
  <node oor:name="Execute">
    <node oor:name="Disabled">
      <node oor:name="DainvoOpenRemote" oor:op="replace">
        <prop oor:name="Command">
          <value>OpenRemote</value>
        </prop>
      </node>
      <node oor:name="DainvoSaveAsRemote" oor:op="replace">
        <prop oor:name="Command">
          <value>SaveAsRemote</value>
        </prop>
      </node>
