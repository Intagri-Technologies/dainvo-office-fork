<!-- Dainvo: Tools > Options pages for features Dainvo doesn't ship -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="OptionsDialog" oor:package="org.openoffice.Office">
  <node oor:name="OptionsDialogGroups">
    <!-- Base: Dainvo has no database layer, so the whole group goes -->
    <node oor:name="Base" oor:op="replace">
      <prop oor:name="Hide" oor:type="xs:boolean">
        <value>true</value>
      </prop>
    </node>
    <!-- Basic IDE settings only matter to macro authors; macros are off by
         default -->
    <node oor:name="ProductName" oor:op="replace">
      <node oor:name="Pages">
        <node oor:name="BasicIDEOptions" oor:op="replace">
          <prop oor:name="Hide" oor:type="xs:boolean">
            <value>true</value>
          </prop>
        </node>
      </node>
    </node>
    <!-- LanguageTool Server: remote grammar checker setup; Dainvo will offer
         its own grammar checking -->
    <node oor:name="LanguageSettings" oor:op="replace">
      <node oor:name="Pages">
        <node oor:name="LanguageTool" oor:op="replace">
          <prop oor:name="Hide" oor:type="xs:boolean">
            <value>true</value>
          </prop>
        </node>
      </node>
    </node>
    <!-- Writer > Mail Merge Email: sending merge results by email needs the
         Python mail service, which Dainvo doesn't ship -->
    <node oor:name="Writer" oor:op="replace">
      <node oor:name="Pages">
        <node oor:name="MailMerge" oor:op="replace">
          <prop oor:name="Hide" oor:type="xs:boolean">
            <value>true</value>
          </prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
