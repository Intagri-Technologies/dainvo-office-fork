<?xml version="1.0" encoding="UTF-8"?>
<interface domain="cui">
  <requires lib="gtk+" version="3.24" />
  <object class="GtkListStore" id="fontstore">
    <columns>
      <!-- column-name checked -->
      <column type="gboolean"/>
      <!-- column-name family -->
      <column type="gchararray"/>
      <!-- column-name status -->
      <column type="gchararray"/>
      <!-- column-name related -->
      <column type="gchararray"/>
      <!-- column-name id -->
      <column type="gchararray"/>
      <!-- column-name check-visible -->
      <column type="gboolean"/>
      <!-- column-name check-tristate -->
      <column type="gboolean"/>
    </columns>
  </object>
  <object class="GtkDialog" id="FontDialog">
    <property name="title" translatable="yes" context="dainvofontsdialog|title">Compatibility Fonts</property>
    <property name="border-width">12</property>
    <property name="modal">True</property>
    <property name="resizable">True</property>
    <child internal-child="vbox">
      <object class="GtkBox" id="body">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="actions">
            <property name="layout-style">end</property>
            <child>
              <object class="GtkButton" id="import">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes" context="dainvofontsdialog|import">Install from files…</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="scan">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes" context="dainvofontsdialog|scan">Rescan</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="install">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes" context="dainvofontsdialog|install">Install selected</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes" context="dainvofontsdialog|close">Close</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="pack-type">end</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="intro">
            <property name="visible">True</property>
            <property name="label" translatable="yes" context="dainvofontsdialog|intro">Check the fonts you want to install. Select a row for its source and license.</property>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
            <property name="mnemonic-widget">fonts</property>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="scroll">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="fonts">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="model">fontstore</property>
                <property name="headers-visible">True</property>
                <property name="show-expanders">False</property>
                <child internal-child="accessible">
                  <object class="AtkObject" id="fonts-accessible">
                    <property name="AtkObject::accessible-name" translatable="yes" context="dainvofontsdialog|fontlist">Compatibility fonts</property>
                  </object>
                </child>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="font-selection" />
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="check">
                    <property name="title" translatable="yes" context="dainvofontsdialog|check">Install</property>
                    <property name="resizable">True</property>
                    <child>
                      <object class="GtkCellRendererToggle" id="render-check" />
                      <attributes>
                        <attribute name="active">0</attribute>
                        <attribute name="visible">5</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="family">
                    <property name="title" translatable="yes" context="dainvofontsdialog|family">Font</property>
                    <property name="resizable">True</property>
                    <child>
                      <object class="GtkCellRendererText" id="render-family" />
                      <attributes>
                        <attribute name="text">1</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="state">
                    <property name="title" translatable="yes" context="dainvofontsdialog|state">Status</property>
                    <property name="resizable">True</property>
                    <child>
                      <object class="GtkCellRendererText" id="render-state" />
                      <attributes>
                        <attribute name="text">2</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="alternate">
                    <property name="title" translatable="yes" context="dainvofontsdialog|alternate">Related font</property>
                    <property name="resizable">True</property>
                    <child>
                      <object class="GtkCellRendererText" id="render-alternate" />
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="links">
            <property name="visible">True</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLinkButton" id="source">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes" context="dainvofontsdialog|source">Open font source</property>
                <property name="uri" />
              </object>
            </child>
            <child>
              <object class="GtkLinkButton" id="license">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="uri" />
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="accept">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="label" translatable="yes" context="dainvofontsdialog|accept">I accept the license terms for the selected fonts.</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="formats">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes" context="dainvofontsdialog|formats">Use Word, Excel &amp; PowerPoint formats</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="status">
            <property name="visible">True</property>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-7">close</action-widget>
    </action-widgets>
  </object>
</interface>
