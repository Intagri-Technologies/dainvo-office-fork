{
  "_comment": "Dainvo Office ribbon spec. Each tab is a list of groups. A group has L (large labelled buttons), R (one or two rows of small icon buttons), G (a gallery command) and L2 (large buttons after the gallery). Append |o to an item to leave it out of the icons-only layout. Run dainvo/ribbon/generate.py after editing.",
  "documents": {
    "file": "sw/uiconfig/swriter/ui/notebookbar.ui",
    "compact": "sw/uiconfig/swriter/ui/notebookbar_compact.ui",
    "context": "TabbedWriter",
    "suppr": "solenv/sanitizers/ui/modules/swriter.suppr",
    "compactGallery": ".uno:StyleApply",
    "tabs": [
      ["Home", [
        {"R": [[".uno:Undo"], [".uno:Redo"]]},
        {"L": [".uno:Paste"], "R": [[".uno:Cut", ".uno:Copy"], [".uno:FormatPaintbrush"]]},
        {"R": [[".uno:CharFontName", ".uno:FontHeight", ".uno:Grow|o", ".uno:Shrink|o", ".uno:ResetAttributes"],
               [".uno:Bold", ".uno:Italic", ".uno:Underline", ".uno:Strikeout", ".uno:SubScript|o", ".uno:SuperScript|o", ".uno:CharBackColor", ".uno:Color"]]},
        {"R": [[".uno:DefaultBullet", ".uno:DefaultNumbering", ".uno:SetOutline|o", ".uno:DecrementIndent", ".uno:IncrementIndent", ".uno:ControlCodes|o"],
               [".uno:LeftPara", ".uno:CenterPara", ".uno:RightPara", ".uno:JustifyPara", ".uno:LineSpacing", ".uno:BackgroundColor|o", ".uno:SetBorderStyle|o"]]},
        {"G": ".uno:StylesPreview", "L2": [".uno:DesignerDialog"]},
        {"R": [[".uno:SearchDialog"]]}
      ]],
      ["Insert", [
        {"L": [".uno:InsertPagebreak"]},
        {"L": [".uno:InsertTable"]},
        {"L": [".uno:InsertGraphic", ".uno:BasicShapes", ".uno:InsertObjectChart"]},
        {"L": [".uno:DrawText"], "R": [[".uno:InsertPageHeader", ".uno:InsertPageFooter"], [".uno:InsertPageNumberField", ".uno:InsertFieldCtrl"]]},
        {"R": [[".uno:HyperlinkDialog"], [".uno:InsertBookmark"]]},
        {"L": [".uno:InsertAnnotation"]},
        {"R": [[".uno:InsertObjectStarMath"], [".uno:CharmapControl"]]}
      ]],
      ["Layout", [
        {"L": [".uno:PageMargin", ".uno:Orientation", ".uno:AttributePageSize", ".uno:PageColumnType"], "R": [[".uno:InsertBreak"], [".uno:LineNumberingDialog|o", ".uno:Hyphenate|o"]]},
        {"R": [[".uno:LeftParaMargin", ".uno:AboveSpacing"], [".uno:RightParaMargin", ".uno:BelowSpacing"]]},
        {"L": [".uno:TextWrap"], "R": [[".uno:ObjectForwardOne", ".uno:ObjectBackOne"], [".uno:ObjectAlign", ".uno:FormatGroup", ".uno:RotateRight"]]}
      ]],
      ["References", [
        {"L": [".uno:InsertMultiIndex"], "R": [[".uno:UpdateAllIndexes"]]},
        {"L": [".uno:InsertFootnote", ".uno:InsertEndnote"]},
        {"L": [".uno:InsertAuthoritiesEntry"]},
        {"L": [".uno:InsertCaptionDialog"], "R": [[".uno:InsertReferenceField"]]},
        {"L": [".uno:InsertIndexesEntry"], "R": [[".uno:UpdateCurIndex"]]}
      ]],
      ["Review", [
        {"L": [".uno:SpellingAndGrammarDialog"], "R": [[".uno:ThesaurusDialog", ".uno:SpellOnline"], [".uno:WordCountDialog"]]},
        {"L": [".uno:InsertAnnotation"], "R": [[".uno:DeleteComment", ".uno:PreviousAnnotation"], [".uno:ShowAnnotations", ".uno:NextAnnotation"]]},
        {"L": [".uno:TrackChanges"], "R": [[".uno:ShowTrackedChanges"], [".uno:AcceptTrackedChanges"]]},
        {"L": [".uno:AcceptTrackedChange", ".uno:RejectTrackedChange"], "R": [[".uno:PreviousTrackedChange"], [".uno:NextTrackedChange"]]},
        {"L": [".uno:CompareDocuments", ".uno:ProtectTraceChangeMode"]}
      ]],
      ["View", [
        {"L": [".uno:PrintLayout", ".uno:BrowseView", ".uno:FullScreen"]},
        {"R": [[".uno:Ruler", ".uno:ControlCodes"], [".uno:Navigator"]]},
        {"L": [".uno:Zoom"], "R": [[".uno:Zoom100Percent", ".uno:ZoomPageWidth"], [".uno:ShowMultiplePages", ".uno:ZoomPage"]]},
        {"L": [".uno:Sidebar"]}
      ]]
    ]
  },
  "spreadsheets": {
