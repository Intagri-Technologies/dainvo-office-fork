        {"L": [".uno:InsertAnnotation"], "R": [[".uno:DeleteNote", ".uno:ShowAllNotes"], [".uno:HideAllNotes", ".uno:DeleteAllNotes"]]},
        {"L": [".uno:TraceChangeMode"], "R": [[".uno:AcceptChanges"]]},
        {"L": [".uno:Protect", ".uno:ToolProtectionDocument"]}
      ]],
      ["View", [
        {"L": [".uno:NormalViewMode", ".uno:PagebreakMode"]},
        {"R": [[".uno:ToggleSheetGrid", ".uno:ViewRowColumnHeaders"], [".uno:InputLineVisible", ".uno:Sidebar"]]},
        {"L": [".uno:FreezePanes", ".uno:SplitWindow"]},
        {"L": [".uno:Zoom"], "R": [[".uno:Zoom100Percent"]]}
