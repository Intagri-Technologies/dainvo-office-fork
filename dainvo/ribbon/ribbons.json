        {"R": [[".uno:AlignLeft", ".uno:AlignHorizontalCenter", ".uno:AlignRight", ".uno:WrapText"],
               [".uno:AlignTop", ".uno:AlignVCenter", ".uno:AlignBottom", ".uno:ToggleMergeCells"]]},
