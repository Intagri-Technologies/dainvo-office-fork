  "presentations": {
    "file": "sd/uiconfig/simpress/ui/notebookbar.ui",
    "compact": "sd/uiconfig/simpress/ui/notebookbar_compact.ui",
    "context": "TabbedImpress",
    "suppr": "solenv/sanitizers/ui/modules/simpress.suppr",
    "tabs": [
      ["Home", [
        {"R": [[".uno:Undo"], [".uno:Redo"]]},
        {"L": [".uno:Paste"], "R": [[".uno:Cut", ".uno:Copy"], [".uno:FormatPaintbrush"]]},
        {"L": [".uno:InsertSlide"], "R": [[".uno:AssignLayout"], [".uno:DuplicateSlide"]]},
        {"R": [[".uno:CharFontName", ".uno:FontHeight", ".uno:Grow|o", ".uno:Shrink|o"],
               [".uno:Bold", ".uno:Italic", ".uno:Underline", ".uno:Strikeout|o", ".uno:Color"]]},
        {"R": [[".uno:DefaultBullet", ".uno:DefaultNumbering", ".uno:DecrementIndent|o", ".uno:IncrementIndent|o"],
               [".uno:LeftPara", ".uno:CenterPara", ".uno:RightPara", ".uno:LineSpacing"]]},
        {"L": [".uno:BasicShapes", ".uno:ObjectPosition"], "R": [[".uno:XLineColor"], [".uno:FillShadow"]]},
        {"R": [[".uno:SearchDialog"]]}
      ]],
      ["Insert", [
        {"L": [".uno:InsertSlide"]},
        {"L": [".uno:InsertTable"]},
        {"L": [".uno:InsertGraphic", ".uno:BasicShapes", ".uno:InsertObjectChart"]},
        {"L": [".uno:InsertAVMedia"]},
        {"L": [".uno:Text"], "R": [[".uno:HeaderAndFooter"]]},
        {"R": [[".uno:HyperlinkDialog"], [".uno:InsertAnnotation"]]},
        {"R": [[".uno:InsertObjectStarMath"], [".uno:CharmapControl"]]}
      ]],
      ["Design", [
        {"L": [".uno:ThemeDialog", ".uno:SlideSetup", ".uno:SelectBackground", ".uno:SlideMasterPage"]}
      ]],
      ["Transitions", [
        {"L": [".uno:SlideChangeWindow"]}
      ]],
      ["Animations", [
        {"L": [".uno:CustomAnimation"]}
      ]],
      ["Slide Show", [
