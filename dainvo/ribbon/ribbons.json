        {"R": [[".uno:HyperlinkDialog"], [".uno:InsertAnnotation"]]},
        {"L": [".uno:DrawText"], "R": [[".uno:EditHeaderAndFooter"]]},
        {"R": [[".uno:FunctionDialog"], [".uno:CharmapControl"]]}
      ]],
      ["Formulas", [
        {"L": [".uno:FunctionDialog", ".uno:AutoSum"]},
        {"L": [".uno:AddName"], "R": [[".uno:DefineName"], [".uno:InsertName"]]},
        {"R": [[".uno:ShowPrecedents", ".uno:ShowDependents"], [".uno:ClearArrows", ".uno:ShowErrors"]]},
        {"L": [".uno:Calculate"]}
