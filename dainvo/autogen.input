# Example autogen.input for building Dainvo Office on macOS.
# Copy to the repository root as autogen.input (git ignores it there) and
# adjust the machine-specific lines. All shared Dainvo options live in
# distro-configs/DainvoMacOS.conf.
INCLUDE:DainvoMacOS

# Machine-specific
--with-branding=/full/path/to/this/repo/dainvo/branding
--enable-ccache
--with-parallelism=8
PKG_CONFIG=/opt/homebrew/bin/pkg-config
